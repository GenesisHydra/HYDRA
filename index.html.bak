

<!DOCTYPE html>
<html lang="es" dir="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GenesisHydra - Finanzas y Tesorería</title>
    <meta name="description" content="Transformando simulaciones en empresas reales | Automatización de reportes financieros y dashboards para PYMES">
    <meta name="keywords" content="HYDRA, automatización, negocios, PYMES, treasury, stripe">
    <meta name="author" content="HYDRA Business Automation Platform">
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/static/img/logo-hydra.svg">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.css">
    
    <style>
        :root {
            --primary: #1a1a2e;
            --secondary: #1f2937;
            --accent: #e94a4a;
            --light: #f9fafb;
            --muted: #6b7280;
        }
        
        /* Eye animation styles */
        @keyframes blink {
            0%, 90%, 100% { transform: scaleY(1); }
            95% { transform: scaleY(0.1); }
        }
        @keyframes pupilMove {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(-8px, -4px); }
            50% { transform: translate(8px, 4px); }
            75% { transform: translate(-4px, 8px); }
        }
        @keyframes glow {
            0%, 100% { filter: drop-shadow(0 0 20px rgba(233, 74, 74, 0.4)); }
            50% { filter: drop-shadow(0 0 40px rgba(233, 74, 74, 0.8)); }
        }
    </style>
</head>
<body class="bg-white text-primary">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur border-b border-border">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <a href="/" class="font-bold text-2xl tracking-wider" style="color: var(--primary);">
                    HYDRA <span style="color: var(--accent);">Business</span>
                </a>
                <button class="md:hidden text-gray-700" onclick="toggleMenu()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <div id="mobileMenu" class="hidden md:block">
                <a href="/financial" class="ml-6 text-gray-700 hover:text var(--accent)">Servicios</a>
                <a href="/quienes-somos/financial" class="ml-6 text-gray-700 hover:text var(--accent)">Quiénes Somos</a>
                <a href="/contacto/financial" class="ml-6 text-gray-700 hover:text var(--accent)">Contacto</a>
                <a href="/politica-de-privacidad" class="ml-6 text-gray-700 hover:text var(--accent)">Privacy</a>
                <a href="/terminos-y-condiciones" class="ml-6 text-gray-700 hover:text var(--accent)">Terms</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-20 pb-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h1 class="text-5xl md:text-6xl font-bold tracking-tight" style="color: var(--primary);">
                        GenesisHydra
                    </h1>
                    <p class="text-lg mt-4 text-gray-700 leading-relaxed">
                        Transformando simulaciones en empresas reales
                    </p>
                    <div class="mt-6">
                        <a href="/contacto/financial" 
                           class="inline-block px-6 py-3 bg-accent text-white font-medium rounded-full hover:opacity-90 transition-opacity">
                            Solicitar información
                        </a>
                        <a href="/servicios/financial" 
                           class="inline-block mt-4 px-6 py-3 border-2 border-accent text-accent font-medium rounded-full hover:bg-accent hover:text-white transition-colors">
                            Conocer nuestros planes
                        </a>
                    </div>
                </div>
                <div class="relative hidden lg:block flex justify-center items-center">
                    <!-- Big Eye SVG -->
                    <svg viewBox="0 0 400 300" class="w-full max-w-lg h-auto" style="filter: drop-shadow(0 0 30px rgba(233, 74, 74, 0.5)); animation: glow 3s ease-in-out infinite;">
                        <defs>
                            <radialGradient id="irisGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#2d1b1b"/>
                                <stop offset="60%" stop-color="#1a0d0d"/>
                                <stop offset="100%" stop-color="#0a0303"/>
                            </radialGradient>
                            <radialGradient id="scleraGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#ffffff"/>
                                <stop offset="50%" stop-color="#f0f0f0"/>
                                <stop offset="100%" stop-color="#e0e0e0"/>
                            </radialGradient>
                            <radialGradient id="pupilGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#000000"/>
                                <stop offset="100%" stop-color="#0a0a0a"/>
                            </radialGradient>
                            <filter id="eyeShadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#e94a4a" flood-opacity="0.3"/>
                            </filter>
                        </defs>
                        <!-- Eye white (sclera) -->
                        <ellipse cx="200" cy="150" rx="180" ry="120" fill="url(#scleraGradient)" filter="url(#eyeShadow)"/>
                        <!-- Iris -->
                        <ellipse cx="200" cy="150" rx="110" ry="110" fill="url(#irisGradient)">
                            <animate attributeName="ry" values="110;15;110" dur="4s" repeatCount="indefinite" begin="0s"/>
                        </ellipse>
                        <!-- Pupil -->
                        <ellipse cx="200" cy="150" rx="50" ry="50" fill="url(#pupilGradient)">
                            <animate attributeName="rx" values="50;5;50" dur="4s" repeatCount="indefinite" begin="0s"/>
                            <animate attributeName="ry" values="50;5;50" dur="4s" repeatCount="indefinite" begin="0s"/>
                            <animateMotion dur="8s" repeatCount="indefinite">
                                <mpath href="#pupilPath"/>
                            </animateMotion>
                        </ellipse>
                        <path id="pupilPath" d="M0,0 Q-8,-4 8,4 Q-4,8 0,0" fill="none" stroke="none"/>
                        <!-- Highlight/reflection -->
                        <ellipse cx="165" cy="110" rx="18" ry="12" fill="white" opacity="0.8" filter="blur(2px)"/>
                        <ellipse cx="185" cy="125" rx="8" ry="6" fill="white" opacity="0.5"/>
                        <!-- Red accent ring -->
                        <ellipse cx="200" cy="150" rx="115" ry="115" fill="none" stroke="var(--accent)" stroke-width="3" opacity="0.6"/>
                        <!-- Outer decorative ring -->
                        <ellipse cx="200" cy="150" rx="185" ry="125" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.2" stroke-dasharray="10,10">
                            <animateTransform attributeName="transform" type="rotate" from="0 200 150" to="360 200 150" dur="60s" repeatCount="indefinite"/>
                        </ellipse>
                    </svg>
                    <!-- HYDRA text below eye -->
                    <div class="absolute bottom-[-60px] left-1/2 -translate-x-1/2 text-center">
                        <span class="text-xs font-mono tracking-widest text-accent/70 uppercase">H Y D R A</span>
                        <div class="w-24 h-px bg-accent/30 mx-auto mt-2"></div>
                        <span class="text-xs text-gray-500">watching your business</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-12 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-3xl font-bold mb-6 text-center text-primary">Soluciones para Finanzas y Tesorería</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <div class="p-6 rounded-lg border border-gray-200 hover:bg-accent/5 hover:text-accent transition-colors">
                    <div class="text-3xl md:text-4xl font-bold mt-2" style="color: var(--accent);">
                        <i class="fas fa-check-circle mr-3"></i>Smart Treasury
                    </div>
                </div>
                
                <div class="p-6 rounded-lg border border-gray-200 hover:bg-accent/5 hover:text-accent transition-colors">
                    <div class="text-3xl md:text-4xl font-bold mt-2" style="color: var(--accent);">
                        <i class="fas fa-check-circle mr-3"></i>Cash Flow
                    </div>
                </div>
                
                <div class="p-6 rounded-lg border border-gray-200 hover:bg-accent/5 hover:text-accent transition-colors">
                    <div class="text-3xl md:text-4xl font-bold mt-2" style="color: var(--accent);">
                        <i class="fas fa-check-circle mr-3"></i>Reportes Automáticos
                    </div>
                </div>
                
                <div class="p-6 rounded-lg border border-gray-200 hover:bg-accent/5 hover:text-accent transition-colors">
                    <div class="text-3xl md:text-4xl font-bold mt-2" style="color: var(--accent);">
                        <i class="fas fa-check-circle mr-3"></i>Panel de Control
                    </div>
                </div>
                
            </div>
        </div>
    </section>

    <!-- Social Proof -->
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-3xl font-bold" style="color: var(--accent);">1,000+</div>
                    <div>PYMES automatizadas</div>
                </div>
                <div class="p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-3xl font-bold" style="color: var(--accent);">98%</div>
                    <div>Tasa de satisfacción</div>
                </div>
                <div class="p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-3xl font-bold" style="color: var(--accent);">24/7</div>
                    <div>Soporte disponible</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-12 bg-primary text-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center">
                <h2 class="text-4xl font-bold mb-4">Listo para transformar tu negocio?</h2>
                <p class="text-lg mb-6 max-w-xl mx-auto text-gray-300">Únete a cientos de PYMES que ya automatizaron sus finanzas y operaciones</p>
                <a href="/contacto/financial" 
                   class="inline-block px-8 py-4 bg-accent text-white font-medium rounded-full hover:opacity-90 transition-opacity">
                    Contacto hoy mismo
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-50 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
                <div>
                    <h4 class="font-bold text-primary mb-4">HYDRA</h4>
                    <p class="text-gray-700 text-sm">Plataforma de automatización para PYMES</p>
                </div>
                <div>
                    <h4 class="font-bold text-primary text-sm">Producto</h4>
                    <ul class="text-gray-700 text-sm">
                        <li><a href="/servicios/financial" class="hover:text-accent">Planes y Precios</a></li>
                        <li><a href="/quienes-somos/financial" class="hover:text-accent">Características</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold text-primary text-sm">Recursos</h4>
                    <ul class="text-gray-700 text-sm">
                        <li><a href="/blog/financial" class="hover:text-accent">Blog</a></li>
                        <li><a href="/politica-de-privacidad" class="hover:text-accent">Privacy</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold text-primary text-sm">Empresa</h4>
                    <ul class="text-gray-700 text-sm">
                        <li><a href="/quienes-somos/financial" class="hover:text-accent">Quiénes Somos</a></li>
                        <li><a href="/terminos-y-condiciones" class="hover:text-accent">Términos</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold text-primary text-sm">Contacto</h4>
                    <ul class="text-gray-700 text-sm">
                        <li><a href="/contacto/financial" class="hover:text-accent">Contacto</a></li>
                        <li><a href="/politica-de-cookies" class="hover:text-accent">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="mt-8 pt-8 border-t border-gray-200">
                <p class="text-center text-gray-600 text-sm">© 2026 HYDRA Business Automation Platform. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script>
        function toggleMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('md:block');
        }
    </script>
</body>
</html>HTMLEOF
